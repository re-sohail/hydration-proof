{
  // Tests, scripts and config files. Same strictness, no declaration rules
  // because none of these files ship.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "isolatedDeclarations": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["tests", "scripts", "*.config.ts"]
}
