---
import Layout from '../layouts/Layout.astro';

const pages = ['/static', '/date-now', '/math-random', '/products/42', '/counter', '/islands'];
---

<Layout title="Astro fixture">
  <h1 id="home">Astro fixture</h1>
  <ul>
    {
      pages.map((path) => (
        <li>
          <a href={path}>{path}</a>
        </li>
      ))
    }
  </ul>
</Layout>
