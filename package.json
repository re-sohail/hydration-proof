{
  "name": "hydration-proof-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter \"./packages/*\" typecheck",
    "test": "pnpm --filter \"./packages/*\" test",
    "test:unit": "pnpm --filter hydration-proof test:unit",
    "test:browser": "pnpm --filter hydration-proof test:browser",
    "test:e2e": "pnpm --filter hydration-proof test:e2e",
    "fixtures:build": "node scripts/fixtures-build.ts",
    "verify:fixtures": "node scripts/verify-fixtures.ts",
    "measure": "node scripts/measure.ts",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "docs": "node scripts/generate-docs.ts",
    "docs:check": "node scripts/generate-docs.ts --check"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "^22.20.3",
    "playwright-core": "^1.63.0",
    "typescript": "6.0.3"
  }
}
